# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=

# Map — satellite imagery for /map (no key needed): esri (default) | eox (Sentinel-2 cloudless 2020)
NEXT_PUBLIC_BASEMAP=esri

# Supabase
NEXT_PUBLIC_SUPABASE_URL=            # local: http://127.0.0.1:55421 (supabase/config.toml ใช้ port 554xx)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # ใช้ฝั่ง server/ETL/worker เท่านั้น
DATABASE_URL=                         # สำหรับ ETL (direct connection)
SUPABASE_JWT_SECRET=                  # server only — HS256 secret ที่ PostgREST ใช้ตรวจ JWT (local: `supabase status -o env` → JWT_SECRET; hosted: Project Settings → JWT Keys → Legacy JWT secret) ใช้เซ็น token ให้ RLS เห็น auth.uid() (D-026) ห้ามใส่ NEXT_PUBLIC_

# Auth.js v5 — เข้าสู่ระบบด้วย Google เท่านั้น (D-026)
AUTH_SECRET=                          # server only — สุ่มด้วย `openssl rand -base64 32` (หรือ `npx auth secret`)
AUTH_GOOGLE_ID=                       # Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application)
AUTH_GOOGLE_SECRET=                   # server only
AUTH_URL=http://localhost:3000        # optional · URL หลักของเว็บ (production ต้องตั้ง หรือใช้ AUTH_TRUST_HOST=true หลัง proxy ที่เชื่อถือได้)
AUTH_DEV_BYPASS=                       # dev only: 1 = ปุ่มเข้าสู่ระบบแบบทดสอบ (ถูกปิดเสมอใน production)
# Authorized redirect URI ใน Google Console: http://localhost:3000/api/auth/callback/google
#                                         และ https://<production-domain>/api/auth/callback/google

# ETL
THAIWATER_API_KEY=
TMD_API_KEY=
GEE_SERVICE_ACCOUNT_JSON=
ETL_ALERT_WEBHOOK=
GITHUB_DISPATCH_TOKEN=                # ใช้ฝั่ง server เท่านั้น
SUPABASE_URL=                         # ETL / --upload-raw (server-side)
ETL_RAW_DIR=                          # default etl/.raw
ETL_OPENMETEO_BUDGET=8000             # weighted calls per run
ETL_OPENMETEO_PAUSE_S=30
ETL_NASAPOWER_WORKERS=4               # NASA POWER concurrent requests (capped at 4)
ETL_NASAPOWER_MIN_INTERVAL_S=1.5      # min seconds between NASA POWER request starts (429 guard)
ETL_NASAPOWER_LAND_KM=15              # keep 0.25° points within this distance of a province
